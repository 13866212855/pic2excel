# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing admin authentication tokens
JWT_SECRET="image_excel_extractor_super_secret_jwt_key_2026"

# Default Model Configuration (Initialized in database on startup, editable via /admin)
DEFAULT_AI_BASE_URL="https://apihub.agnes-ai.com/v1"
DEFAULT_AI_API_KEY="sk-GUdpKQNIwwJSZQ5mYyrMnuCJBOwSbB73c2N6NcnNfk5LoKyq"
DEFAULT_AI_TEXT_MODEL="Agnes-2.5-flash"
DEFAULT_AI_IMAGE_MODEL="Agnes-Image-2.1-flash"

# Admin Initial Seed Credentials (Hashed in database, never exposed in client)
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_PASSWORD="admin123"

